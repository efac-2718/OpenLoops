{
  "expo": {
    "name": "Open Loops",
    "slug": "open-loops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "openloops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.efac2781.openloops"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.efac2781.openloops"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "LoopsWidget",
              "displayName": "Open Loops",
              "description": "Your inbox and today at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2
              }
            }
          ]
        }
      ],
      "./plugins/with-android-shortcuts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8663987e-85ea-4f54-b50a-4ba07ca676ab"
    },
    "owner": "efac_2781",
    "extra": {
      "eas": {
        "projectId": "8663987e-85ea-4f54-b50a-4ba07ca676ab"
      }
    }
  }
}
